# ─── Unified config for the Engine (FastAPI) + chrome_app (Flutter) ───
# Copy to Engine/.env and fill in. chrome_app/.env is a symlink to this file.
#
# Flutter reads: SUPABASE_URL, SUPABASE_ANON_KEY, INFERENCE_API_URL, CHATBOT_API_URL
# Backend reads: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, GROQ_API_KEY, GROQ_MODEL

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Engine base URL as seen by the Flutter client.
INFERENCE_API_URL=http://localhost:8000
CHATBOT_API_URL=http://localhost:8000

# ─── LLM (Groq — free tier) ───
# Get a free key at: https://console.groq.com
GROQ_API_KEY=your_groq_key
GROQ_MODEL=llama-3.1-8b-instant

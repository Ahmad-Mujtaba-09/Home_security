# ─── Mobile App Config ───
# Copy to mobile_app/.env and fill in.
#
# A phone cannot reach `localhost` on your dev machine. Either use the machine's
# LAN IP, or tunnel with ngrok:
#   1. Run:  ngrok http 8000
#   2. Copy the https://xxx.ngrok-free.app URL
#   3. Paste below — https:// for REST, the app swaps in wss:// for WebSocket
# The server URL is also settable at runtime under Profile → Server Connection.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key

INFERENCE_API_URL=http://192.168.1.10:8000
CHATBOT_API_URL=http://192.168.1.10:8000

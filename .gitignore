# ==============================================================================
# IHS .gitignore
# Tracked source: Engine/, chrome_app/, mobile_app/, supabase/ (+ root files)
# ==============================================================================

# ─── Large / non-source top-level directories ────────────────────────────────
/books/
/docs/
/weights/

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
venv/
.venv/
env/
.env.local
.pytest_cache/

# ─── Engine-specific ignores ─────────────────────────────────────────────────
Engine/__pycache__/
Engine/.vscode/
Engine/datasets/
Engine/testing/
Engine/embeddings/
Engine/firebase-service-account.json
Engine/*.errors.txt

# ─── Flutter / Dart — chrome_app (desktop/web control panel) ─────────────────
chrome_app/.dart_tool/
chrome_app/.idea/
chrome_app/build/
chrome_app/.flutter-plugins
chrome_app/.flutter-plugins-dependencies
chrome_app/.metadata
chrome_app/pubspec.lock
chrome_app/*.iml
chrome_app/android/local.properties
chrome_app/ios/Flutter/Generated.xcconfig
chrome_app/ios/Flutter/flutter_export_environment.sh

# ─── Flutter / Dart — mobile_app ─────────────────────────────────────────────
mobile_app/.dart_tool/
mobile_app/.idea/
mobile_app/build/
mobile_app/.flutter-plugins
mobile_app/.flutter-plugins-dependencies
mobile_app/.metadata
mobile_app/pubspec.lock
mobile_app/*.iml
mobile_app/android/local.properties

# ─── IDE ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Secrets (never commit) ──────────────────────────────────────────────────
*.env
!mobile_app/.env.example
!Engine/.env.example
firebase-service-account.json
google-services.json
GoogleService-Info.plist

# ─── Misc ─────────────────────────────────────────────────────────────────────
*.log
*.errors.txt
*.mp4
*.pt
*.h5
*.npy
*.index
*.zip
